	<!--自定义生成-->
	<PropertyGroup>
		<PluginTarget>Build</PluginTarget>
		<PluginProperties>WarningsAsErrors=false;SatelliteResourceLanguages=zh-Hans;Configuration=$(Configuration); Platform=$(Platform);TargetFramework=$(TargetFramework);</PluginProperties>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PluginTarget>Rebuild</PluginTarget>
	</PropertyGroup>
	<Target Name="PluginRebuild" BeforeTargets="BeforeRebuild">
		<PropertyGroup>
			<PluginTarget>Rebuild</PluginTarget>
		</PropertyGroup>
	</Target>
	<Target Name="PluginClean" AfterTargets="BeforeClean">
		<Message Text="清理插件" Importance="high" />
		<MSBuild Projects="@(ProjectReference);@(PluginBaseProject);@(PluginPublishProject)" Targets="Clean" BuildInParallel="true" Properties="$(PluginProperties)" />
	</Target>
	<Target Name="PluginBase" AfterTargets="BeforeBuild">
		<RemoveDir Directories="$(TargetDir)" ContinueOnError="true" />
		<Message Text="开始$(PluginTarget)基础库：$(PluginProperties)" Importance="high" />
		<MSBuild Projects="@(ProjectReference);@(PluginBaseProject)" Targets="$(PluginTarget)" Properties="$(PluginProperties)" />
		<Message Text="开始$(PluginTarget)插件：$(PluginProperties)" Importance="high" />
		<MSBuild Projects="@(PluginPublishProject)" Targets="$(PluginTarget)" BuildInParallel="true" Properties="$(PluginProperties)">
			<Output ItemName="GeneratedFiles" TaskParameter="TargetOutputs" />
		</MSBuild>
		<ItemGroup>
			<PluginFiles Include="%(GeneratedFiles.RelativeDir)*.dll;%(GeneratedFiles.RelativeDir)*.pdb;%(GeneratedFiles.RelativeDir)*.xml"></PluginFiles>
		</ItemGroup>
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="ResolveReferences">
			<Output TaskParameter="TargetOutputs" ItemName="MainResolvedFiles" />
		</MSBuild>
		<MSBuild Projects="@(PluginBaseProject);@(PluginPublishProject)" Targets="ResolveReferences" Properties="$(PluginProperties)">
			<Output TaskParameter="TargetOutputs" ItemName="PluginResolvedFiles" />
		</MSBuild>
		<ItemGroup>
			<ResolvedFiles Include="@(PluginResolvedFiles)" Exclude="@(MainResolvedFiles)"></ResolvedFiles>
		</ItemGroup>
		<Copy SourceFiles="@(PluginFiles);@(ResolvedFiles);" DestinationFolder="$(TargetDir)\plugins\" />
	</Target>
	<Target Name="RemoveDLL" AfterTargets="Build">
		<Message Text="清理多余的dll" Importance="high" />
		<ItemGroup>
			<AboveFile Include="$(TargetDir)\*.*"></AboveFile>
		</ItemGroup>
		<Delete Files="@(AboveFile->'$(TargetDir)\plugins\%(filename)%(extension)')" />
	</Target>
	<Target Name="CorpPlugins" AfterTargets="Publish">
		<Message Text="开始发布插件" Importance="high" />
		<ItemGroup>
			<PublishFile Include="$(TargetDir)\plugins\*.dll;$(TargetDir)\plugins\*.pdb;$(TargetDir)\plugins\*.xml;"></PublishFile>
		</ItemGroup>
		<Copy SourceFiles="@(PublishFile)" DestinationFolder="$(PublishDir)\plugins\" />
	</Target>


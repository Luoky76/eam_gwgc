@using System;
@using System.Text;
@using RazorEngineCore
@using Gksyb.Common;
@using Gksyb.Common.Data
@inherits RazorEngineTemplateBase<DbTableInfo>
@{
    var mapName = Model.Name.ToPascal().ToVariableCase();
    var htmlName = mapName.ToKebabCase();
    var modules = (string.IsNullOrWhiteSpace(Model.Module) ? "Gksyb.Server" : Model.Module).Split('.').Where(c => !string.IsNullOrWhiteSpace(c)).ToList();
    var url = modules.Take(2).LastOrDefault();
    url = string.IsNullOrWhiteSpace(url) ? mapName : $"{url.ToLowerInvariant()}/{mapName}";
    var skipPropertys = new List<string>() { "MODIFYUSERID", "MODIFY_USERID", "MODIFYUSER", "MODIFYDATE", "CREATEUSERID", "CREATE_USERID", "CREATEUSER", "CREATEDATE", "RECORDSTATUS" };
    var skipColumnPropertys = new List<string>() { "MODIFYUSERID", "MODIFY_USERID", "CREATEUSERID", "CREATE_USERID", "RECORDSTATUS" };
    var changeType = new Dictionary<string, string>() { { "DateTime", "date" }, { "long", "int" } };
    var changeName = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) { { "MODIFYUSER", "修改人" }, { "MODIFYDATE", "修改时间" }, { "CREATEUSER", "创建人" }, { "CREATEDATE", "创建时间" } };
    var fields = new List<string>();
    var columns = new List<string>();
    foreach (var item in Model.Columns)
    {
        if (item.IsPrimary == true || item.IsIdentity == true) continue;
        var colType = changeType.ContainsKey(item.CsType) ? changeType[item.CsType] : item.CsType;
        var comment = item.Comment ?? item.Name;
        if (!skipPropertys.Any(a => a.Equals(item.Name, StringComparison.OrdinalIgnoreCase)))
        {
            fields.Add($@"{{ display: ""{comment}"", name: ""_search_{item.Name}"", dbname: ""{item.Name}"", newline: false, upper: false, type: ""{colType}"", options: {{}} }}");
        }
        if (!skipColumnPropertys.Any(a => a.Equals(item.Name, StringComparison.OrdinalIgnoreCase)))
        {
            var editor = $@", editor: {{ type: ""{colType}""{(colType == "date" ? @", showTime: true, format: ""yyyy-MM-dd hh:mm""" : "")} }}";
            if (changeName.ContainsKey(item.Name))
            { 
                comment = changeName[item.Name];
                editor = "";
            }
            columns.Add($@"{{ display: ""{comment}"", name: ""{item.Name}"", type: ""{colType}""{((item.IsNullable == true) ? "" : ", validate: { required: true }")}{editor} }}");
        }
    }
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="renderer" content="webkit" />
    <title></title>
    <script src="../lib/LGboot.js" type="text/javascript"></script>
</head>

<body style="padding: 5px; height: 100%;">
    <div id="mainsearch">
        <form action="" id="formsearch" class="l-form">
        </form>
    </div>
    <form action="" id="mainform">
        <div id="maingrid">
        </div>
    </form>
    <script type="text/javascript">
        'use strict';
        var business = {
            detailWidth: 680,
            detailHeight: 600,
            setConfig: function () {
                var me = this;
                me.config = {
                    search: {
                        fields: [@($"{Environment.NewLine}                            ")@fields.ToStr($",{Environment.NewLine}                            ")
                        ]
                    },
                    grid: {
                        columns: [@($"{Environment.NewLine}                            ")@columns.ToStr($",{Environment.NewLine}                            ")
                        ]
                    }
                };
            },
            grid: null,
            searchForm: null,
            buttons: null,
            loadComboxData: function () {
                //var me = this;
                //LG.ajax({
                //    async: false,
                //    url: '@url/comboxdata',
                //    loading: '正在获取中...',
                //    success: function (data) {
                //        me.dataCorp = data.corpData;
                //    },
                //    error: function (message) {
                //        LG.showError(message);
                //    }
                //});
            },
            setGrid: function () {
                var me = this;
                me.config.grid.columns.removeNull();
                me.grid = $("#maingrid").ligerGrid({
                    dateFormat: 'yyyy-MM-dd HH:mm',
                    autoWidth: true,
                    delayLoad: true,
                    columns: me.config.grid.columns,
                    usePager: false,
                    dataAction: 'local',
                    toolbar: {},
                    url: '@url/list',
                    parms: {
                        where: JSON.stringify({
                            op: 'and',
                            rules: []
                        })
                    },
                    sortName: '@Model.Columns.FirstOrDefault().Name',
                    sortOrder: 'asc',
                    width: '100%',
                    height: '100%',
                    checkbox: true,
                    enabledEdit: true,
                    clickToEdit: true,
                    onBeforeEdit: function (editParm) {
                        switch (editParm.column.name) {
                            case "":
                                if (editParm.record.__status == "add") return true;
                                else return false;
                                break;
                        }
                    },
                    onSuccess: function (data, g) {
                        if (data && data.Rows) {
                            var rows = data.Rows || [];
                            for (var i = 0, len = rows.length; i < len; i++) {
                                var row = rows[i];
                                row.OLDID = row.ID;
                            }
                        }
                    },
                    rowAttrRender: function (rowdata, rowid) {
                        return "";
                    }
                });
                me.grid.isValid = true;
                me.loadToolbar();
                me.bindGridEvent();
            },
            loadToolbar: function () {
                var me = this;
                me.toolbarBtnItemClick = function (item) {
                    switch (item.id) {
                        case "refresh":
                            me.reload();
                            break;
                        case "add":
                            me.add();
                            break;
                        case "modify":
                            me.modify();
                            break;
                        case "delete":
                            me.delete();
                            break;
                        case "save":
                            me.save();
                            break;
                        case "Excel":
                            $.ligerDialog.open({ url: window.gksybConfigs.getUrl("System/Export.html?exporttype=xls", window.gksybConfigs.urlBase), modal: true });
                            break;
                        case "Word":
                            $.ligerDialog.open({ url: window.gksybConfigs.getUrl("System/Export.html?exporttype=doc", window.gksybConfigs.urlBase), modal: true });
                            break;
                    }
                }
                LG.loadToolbar(me.grid, me.toolbarBtnItemClick);
            },
            add: function () { //新增
                var me = this;
                me.dialog = $.ligerDialog.open({
                    width: me.detailWidth,
                    height: me.detailHeight,
                    allowClose: true,
                    title: '[新增]' + document.title,
                    url: "@htmlName-detail.html",
                    isHidden: false,
                    showMax: false,
                    showToggle: false,
                    showMin: false,
                    isResize: true,
                    slide: false,
                    onClosed: me.reload.bind(me),
                    data: { "sid": null }
                });
                //me.grid.addEditRow({}, true);
            },
            modify: function () { //修改
                var me = this;
                var row = me.grid.getSelectedRow(true);
                if (!row) {
                    LG.tip('请选择行!');
                    return;
                }
                var sid = row.@(Model.Columns.Where(c=>c.IsPrimary == true).Select(c=>c.Name).FirstOrDefault()??"SID");
                me.dialog = $.ligerDialog.open({
                    width: me.detailWidth,
                    height: me.detailHeight,
                    allowClose: true,
                    title: '[修改]' + document.title,
                    url: "@htmlName-detail.html",
                    isHidden: false,
                    showMax: false,
                    showToggle: false,
                    showMin: false,
                    isResize: true,
                    slide: false,
                    onClosed: me.reload.bind(me),
                    data: { "sid": sid }
                });
            },
            save: function () { //保存
                var me = this;
                if (me.grid.endEdit() === false) return;
                if (!me.grid.isDataChanged) {
                    LG.showSuccess('无修改');
                    return;
                }
                if (!me.grid.validChangeRows()) return false;
                var changeRow = me.grid.getChangedRows();
                LG.ajax({
                    jsToken: true,
                    url: '@url/save',
                    loading: '正在保存中...',
                    data: changeRow,
                    success: function () {
                        LG.showSuccess('保存成功');
                        me.grid.isDataChanged = false;
                        me.reload();
                    },
                    error: function (message) {
                        LG.showError(message);
                    }
                });
            },
            reload: function () { //刷新
                var me = this;
                me.buttons[0].click();
            },
            delete: function () { //删除
                var me = this;
                if (me.grid.endEdit() === false) return;
                var rows = me.grid.getSelectedRows();
                if (rows.length < 1) {
                    LG.tip('请选择行!');
                    return;
                }
                $.ligerDialog.confirm('确定删除吗?', function (confirm) {
                    if (!confirm) return;
                    me.grid.deleteRange(rows);
                    me.save();
                });
            },
            bindGridEvent: function () {
                var me = this;
                var menu = $.ligerMenu({
                    items: [{
                        id: 'Excel',
                        text: '导出Excel',
                        click: function (item) {
                            me.toolbarBtnItemClick(item);
                        },
                        icon: "fa fa-file-excel-o"
                    },
                    {
                        line: true
                    },
                    {
                        id: 'Word',
                        text: '导出Word',
                        click: function (item) {
                            me.toolbarBtnItemClick(item);
                        },
                        icon: "fa fa-file-word-o"
                    }
                    ]
                });
                me.grid.bind("contextmenu", function (parm, e) {
                    menu.show({
                        top: e.pageY,
                        left: e.pageX
                    });
                    return false;
                });
                me.grid.bind('beforeSubmitEdit', function (e) {
                    if (this.isValid) {
                        if (!LG.validator.form()) {
                            LG.showInvalidTip();
                            return false;
                        }
                    } else {
                        $(".l-verify-tip").remove();
                    }
                    return true;
                });
                LG.validate($("#mainform"), {
                    debug: true
                });
            },
            setForm: function () {
                var me = this;
                me.config.search.fields.removeNull();
                var $formsearch = $("#formsearch");
                //搜索表单应用ligerui样式
                me.searchForm = $formsearch.ligerForm({
                    fields: me.config.search ? me.config.search.fields : [],
                    validate: true,
                    buttons: [{
                        text: '查询',
                        width: 60,
                        click: function () {
                            LG.commonSearch($formsearch, me.grid);
                        }
                    }],
                    onAfterSetFields: function (g) {
                        me.searchForm = g;
                        me.buttons = g.options.buttons;
                    }
                });
            },
            init: function () {
                var me = this;
                me.loadComboxData();
                me.setConfig();
                me.setForm();
                me.setGrid();
                me.reload();
                window.closeQuery = function (callback) {
                    if (!me.dialog) return callback();
                    return me.dialog.frame.business.closeQuery(callback);
                };
                return me;
            }
        };
        $(function () {
            business.init();
        });
    </script>
</body>

</html>
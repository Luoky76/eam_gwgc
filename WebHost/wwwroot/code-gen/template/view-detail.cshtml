@using System;
@using System.Text;
@using RazorEngineCore
@using Gksyb.Common;
@using Gksyb.Common.Data
@inherits RazorEngineTemplateBase<DbTableInfo>
@{
    var mapName = Model.Name.ToPascal().ToVariableCase();
    var htmlName = mapName.ToKebabCase();
    var modules = (string.IsNullOrWhiteSpace(Model.Module) ? "Gksyb.Server" : Model.Module).Split('.').Where(c => !string.IsNullOrWhiteSpace(c)).ToList();
    var url = modules.Take(2).LastOrDefault();
    url = string.IsNullOrWhiteSpace(url) ? mapName : $"{url.ToLowerInvariant()}/{mapName}";
    var skipPropertys = new List<string>() { "MODIFYUSERID", "MODIFY_USERID", "MODIFYUSER", "MODIFYDATE", "CREATEUSERID", "CREATE_USERID", "CREATEUSER", "CREATEDATE", "RECORDSTATUS" };
    var changeType = new Dictionary<string, string>() { { "DateTime", "date" }, { "long", "int" } };
    var fields = new List<string>();
    foreach (var item in Model.Columns)
    {
        if (item.IsPrimary == true || item.IsIdentity == true) continue;
        if (skipPropertys.Any(a => a.Equals(item.Name, StringComparison.OrdinalIgnoreCase))) continue;
        var colType = changeType.ContainsKey(item.CsType) ? changeType[item.CsType] : item.CsType;
        var comment = item.Comment ?? item.Name;
        fields.Add($@"{{ display: ""{comment}"", name: ""{item.Name}"", newline: false, upper: false, type: ""{colType}"",{((item.IsNullable == true) ? "" : " validate: { required: true },")} options: {{}} }}");
    }
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="renderer" content="webkit">
    <title>明细</title>
    <script src="../lib/LGboot.js" type="text/javascript"></script>
</head>

<body style="padding: 5px; height: 100%;">
    <form id="mainform">
    </form>
    <script type="text/javascript">
        'use strict';
        var business = {
            dialogData: {},
            isView: true,
            sid: getQueryStringByName("sid"),
            dataCorp: [],
            setConfig: function () {
                var me = this;
                me.config = {
                    form: {
                        fields: [@($"{Environment.NewLine}                            ")@fields.ToStr($",{Environment.NewLine}                            ")
                                ]
                    }
                };
            },
            mainform: null,
            buttons: null,
            loadComboxData: function () {
                //var me = this;
                //LG.ajax({
                //    async: false,
                //    url: '@url/comboxdata',
                //    loading: '正在获取中...',
                //    success: function (data) {
                //        me.dataCorp = data.corpData;
                //    },
                //    error: function (message) {
                //        LG.showError(message);
                //    }
                //});
            },
            loadData: function () {
                var me = this;
                if (!me.sid) {
                    me.mainform.setOrginData({});
                }
                else {
                    LG.ajax({
                        async: false,
                        url: '@url/get',
                        loading: '正在获取中...',
                        data: { id: me.sid },
                        success: function (data, message) {
                            me.mainform.setOrginData(data);
                        },
                        error: function (message) {
                            LG.showError(message);
                        }
                    });
                    if (me.isView) {
                        me.mainform.setReadonly(true);
                    }
                }
                me.mainform.focus();
            },
            save: function () { //保存
                var me = this;
                if ($.isEmptyObject(me.mainform.getChanges())) {
                    LG.showSuccess('无修改');
                    return;
                }
                if (!me.mainform.valid()) {
                    me.mainform.showInvalid();
                    return;
                }
                function handle(data) {
                    return data;
                }
                var data = handle(me.mainform.getData());
                var original = handle(me.mainform.getOrginData());
                var changeRow = new Object();
                if (!me.sid) {
                    changeRow["added"] = [data];
                }
                else {
                    changeRow["updated"] = [data];
                    changeRow["original"] = [original];
                }
                LG.ajax({
                    jsToken: true,
                    url: '@url/save',
                    loading: '正在保存中...',
                    data: changeRow,
                    success: function () {
                        LG.showSuccess('保存成功', function () {
                            location.reload(true);
                        });
                    },
                    error: function (message) {
                        LG.showError(message);
                    }
                });
            },
            closeQuery: function (callback) {
                var me = this;
                if (me._skipConfirm === true || $.isEmptyObject(me.mainform.getChanges())) {
                    callback();
                    delete me._skipConfirm;
                    return;
                }
                $.ligerDialog.confirm($.ligerDefaults.GridString.isContinueByDataChanged, function (confirm) {
                    if (!confirm) return;
                    callback();
                });
            },
            close: function (skipConfirm) {
                var me = this;
                me._skipConfirm = skipConfirm === true ? true : false;
                if (me.dialog) {
                    me.dialog.close();
                    return;
                }
                me.closeQuery(function () {
                    var win = parent || window;
                    if (win.closeCurrentTab) win.closeCurrentTab();
                    else win.close();
                });
            },
            setFormDefaultBtn: function () {
                var me = this;
                //表单底部按钮
                var buttons = [];
                if (!me.isView) {
                    buttons.push({
                        text: '重置', onclick: function () {
                            $.ligerDialog.confirm("确定重置数据吗?", function (confirm) {
                                if (confirm) {
                                    location.reload(true);
                                }
                            });
                        }
                    });
                }
                buttons.push({ text: '关闭', onclick: function () { me.close(); } });
                if (!me.isView) buttons.push({ text: '保存', onclick: function () { me.save() } });
                LG.addFormButtons(buttons);
                me.formButtons = buttons;
            },
            setForm: function () {
                var me = this;
                me.config.form.fields.removeNull();
                var $mainform = $("#mainform")
                //搜索表单应用ligerui样式
                me.mainform = $mainform.ligerForm({
                    EnterMoveNextControl: true,
                    labelAlign: 'right',
                    space: 3,
                    validate: true,
                    fields: me.config.form.fields,
                    labelWidth: 90,
                    inputWidth: 220,
                    onAfterSetFields: function (g) {
                        me.mainform = g;
                        me.buttons = g.options.buttons;
                    }
                });
                me.setFormDefaultBtn();
            },
            init: function () {
                var me = this;
                if (frameElement && frameElement.dialog) {
                    me.dialog = frameElement.dialog;
                    if (me.closeQuery) me.dialog.options.closeQuery = me.closeQuery.bind(me);
                    me.dialogData = me.dialog.get('data') || {};
                    if (me.dialogData.callback) me.callback = me.dialogData.callback;
                    if (me.dialogData.sid) me.sid = me.dialogData.sid;
                    if (me.dialogData.isView) me.isView = me.dialogData.isView === "1";
                }
                me.isView = false;
                me.loadComboxData();
                me.setConfig();
                me.setForm();
                me.loadData();
                return me;
            }
        };
        $(function () {
            business.init();
        });
    </script>
</body>

</html>